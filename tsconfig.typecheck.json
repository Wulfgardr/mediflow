{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev/**/*",
    ".next-e2e/**/*",
    ".next-e2e-smart-import/**/*",
    "tmp-*/**/*"
  ]
}
