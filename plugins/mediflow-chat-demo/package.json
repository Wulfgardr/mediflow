{
  "name": "mediflow-chat-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "start": "node src/stdio.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:falsification": "node scripts/falsify.mjs",
    "prepare:reference": "node scripts/prepare-reference.mjs",
    "test:reference": "node scripts/run-reference.mjs",
    "test:performance-negative": "node scripts/run-reference.mjs --falsify",
    "start:card": "node src/card-stdio.mjs",
    "test:card-reference": "node scripts/run-reference.mjs --card",
    "start:card-fixture": "node --import ../../../scripts/register-strip-types-loader.mjs test/card-stdio-fixture.mjs",
    "test:card-performance-negative": "node scripts/falsify-card-performance.mjs",
    "test:card-desktop": "node scripts/run-reference.mjs --card --desktop-regressions",
    "test:card-desktop-negative": "node scripts/falsify-card-desktop.mjs"
  },
  "dependencies": {
    "@openai/mcp-extensions": "0.1.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  }
}
