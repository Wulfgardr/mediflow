{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.mjs",
    "scripts/**/*.mjs",
    "test/**/*.mjs",
    "test/**/*.d.ts"
  ]
}
