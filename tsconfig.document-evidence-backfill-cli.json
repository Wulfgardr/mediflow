{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./tmp-document-evidence-backfill-cli",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "incremental": false,
    "isolatedModules": false
  },
  "include": [
    "scripts/document-evidence-backfill.ts",
    "scripts/document-evidence-backfill-live-db.ts",
    "scripts/document-source-provenance-audit.ts",
    "lib/domain/documents/document-evidence-backfill.ts",
    "lib/domain/documents/document-source-provenance-audit.ts",
    "lib/domain/documents/document-parse-evidence-artifact.ts",
    "lib/domain/documents/document-evidence-pack.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**/*",
    "tmp-*/**/*"
  ]
}
