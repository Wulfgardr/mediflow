  "components": {
    "securitySchemes": {
      "NativeOrdinarySession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mediflow_session"
      },
      "NativeOrdinaryClientId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-mediflow-paired-client-id"
      },
      "NativeOrdinaryClientToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-mediflow-paired-client-token"
      }
    },
    "schemas": {
      "NativeOrdinaryFunction": {
        "type": "string",
        "enum": [
          "patient_insight",
          "smart_import",
          "document_synthesis",
          "treatment_reasoning"
        ]
      },
      "NativePatientInsightInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "const": "current_patient_insight"
          }
        },
        "description": "Selettore passivo. Le fonti sono acquisite e ricostruite esclusivamente dall’Application Service host; nessun testo o proiezione dal client."
      },
      "NativeSmartImportInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "const": "current_smart_import"
          }
        },
        "description": "Selettore passivo. Le fonti sono acquisite e ricostruite esclusivamente dall’Application Service host; nessun testo o proiezione dal client."
      },
      "NativeTreatmentReasoningInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "const": "current_treatment_reasoning"
          }
        },
        "description": "Selettore passivo. Le fonti sono acquisite e ricostruite esclusivamente dall’Application Service host; nessun testo o proiezione dal client."
      },
      "NativeDocumentSynthesisInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachmentId"
        ],
        "properties": {
          "attachmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "NativeOrdinaryError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "NativeOrdinaryCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptId"
        ],
        "properties": {
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "NativeOrdinaryConsent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptId",
          "expectedDisclosureRevision"
        ],
        "properties": {
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedDisclosureRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "NativeOrdinaryGenerate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptId",
          "modelOptionId",
          "expectedCatalogRevision"
        ],
        "properties": {
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "modelOptionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedCatalogRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "NativeOrdinaryDisclosure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "revision",
          "operation",
          "profileVersion",
          "contextRevision",
          "attemptRevision",
          "qualificationRevision",
          "sourceSha256",
          "payloadSha256",
          "payloadBytes",
          "egress",
          "proposalOnly",
          "clinicalWrites"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "mediflow.chatgpt-ordinary-disclosure.v1"
          },
          "revision": {
            "type": "string",
            "format": "uuid"
          },
          "operation": {
            "$ref": "#/components/schemas/NativeOrdinaryFunction"
          },
          "profileVersion": {
            "type": "string",
            "const": "mediflow.ordinary-redacted-profile.v1"
          },
          "contextRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "attemptRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "qualificationRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^sha256_[0-9a-f]{64}$"
          },
          "payloadSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "payloadBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "egress": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "enum": [
                "auth.openai.com:443",
                "chatgpt.com:443"
              ]
            }
          },
          "proposalOnly": {
            "const": true
          },
          "clinicalWrites": {
            "const": 0
          }
        }
      },
      "NativeOrdinaryCatalog": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "choices"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "format": "uuid"
          },
          "choices": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "optionId",
                "model",
                "effort"
              ],
              "properties": {
                "optionId": {
                  "type": "string",
                  "format": "uuid"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "effort": {
                  "enum": [
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max",
                    "ultra"
                  ]
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "NativeOrdinaryChallenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verificationUrl",
          "userCode"
        ],
        "properties": {
          "verificationUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://(auth\\.openai\\.com|chatgpt\\.com)(:443)?/"
          },
          "userCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "NativeOrdinaryCompleted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "phase",
          "attemptId",
          "functionId",
          "cleanupConfirmed",
          "result"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "mediflow.native-ordinary.v1"
          },
          "phase": {
            "type": "string",
            "const": "completed"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "functionId": {
            "$ref": "#/components/schemas/NativeOrdinaryFunction"
          },
          "cleanupConfirmed": {
            "const": true
          },
          "result": {
            "type": "object",
            "description": "Original function wire, unmodified: Patient Insight/Smart Import preview, Document Synthesis publication or Treatment Reasoning publication. Proposal-only; original parser, receipt and final owner commit remain mandatory.",
            "additionalProperties": true
          }
        }
      },
      "NativeOrdinaryClosed": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "phase",
          "cleanupConfirmed"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "mediflow.chatgpt-ordinary-flow.v1"
          },
          "phase": {
            "type": "string",
            "const": "closed"
          },
          "cleanupConfirmed": {
            "type": "boolean"
          },
          "attemptId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "functionId": {
            "$ref": "#/components/schemas/NativeOrdinaryFunction"
          }
        }
      },
      "NativeOrdinaryPreparation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "functionId",
              "patientId",
              "ambulatoryId",
              "patientRevision",
              "input"
            ],
            "properties": {
              "functionId": {
                "type": "string",
                "const": "patient_insight"
              },
              "patientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "ambulatoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "patientRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "input": {
                "$ref": "#/components/schemas/NativePatientInsightInput"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "functionId",
              "patientId",
              "ambulatoryId",
              "patientRevision",
              "input"
            ],
            "properties": {
              "functionId": {
                "type": "string",
                "const": "smart_import"
              },
              "patientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "ambulatoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "patientRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "input": {
                "$ref": "#/components/schemas/NativeSmartImportInput"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "functionId",
              "patientId",
              "ambulatoryId",
              "patientRevision",
              "input"
            ],
            "properties": {
              "functionId": {
                "type": "string",
                "const": "document_synthesis"
              },
              "patientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "ambulatoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "patientRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "input": {
                "$ref": "#/components/schemas/NativeDocumentSynthesisInput"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "functionId",
              "patientId",
              "ambulatoryId",
              "patientRevision",
              "input"
            ],
            "properties": {
              "functionId": {
                "type": "string",
                "const": "treatment_reasoning"
              },
              "patientId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "ambulatoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001f\\u007f]+$"
              },
              "patientRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "input": {
                "$ref": "#/components/schemas/NativeTreatmentReasoningInput"
              }
            }
          }
        ],
        "description": "Ingress esatto per functionId, massimo 4096 byte UTF-8; ulteriori vincoli runtime: stringhe ben formate, limiti UTF-16, soli oggetti ordinari enumerabili senza proxy/accessor/simboli. Nessuna autorità di sorgente dal DTO."
      },
      "NativeOrdinaryState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "phase",
          "attemptId",
          "functionId",
          "expiresAt"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "mediflow.chatgpt-ordinary-flow.v1"
          },
          "phase": {
            "enum": [
              "preparing",
              "needs_consent",
              "consented",
              "awaiting_login",
              "connected",
              "ready",
              "generating"
            ]
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "functionId": {
            "$ref": "#/components/schemas/NativeOrdinaryFunction"
          },
          "expiresAt": {
            "type": "integer",
            "description": "Absolute Unix milliseconds; never renewed by commands."
          },
          "disclosure": {
            "$ref": "#/components/schemas/NativeOrdinaryDisclosure"
          },
          "catalog": {
            "$ref": "#/components/schemas/NativeOrdinaryCatalog"
          },
          "challenge": {
            "$ref": "#/components/schemas/NativeOrdinaryChallenge"
          }
        }
      }
    }
  }
