  "openapi": "3.1.0",
  "info": {
    "title": "MediFlow native Mac ordinary OpenAI supplemental contract",
    "version": "0.8.6-native-ordinary.1",
    "description": "Supplement to the canonical v1 spec, not a reconstruction of files absent from the supplied snapshot. ADR0134 / ADR0076 Mac addendum. Source/logic candidate, not OS qualification, release or clinical apply."
  },
