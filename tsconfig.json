{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-smart-import/types/**/*.ts",
    ".next-e2e-smart-import/dev/types/**/*.ts",
    ".next-e2e-smart-import-wul126/types/**/*.ts",
    ".next-e2e-smart-import-wul126/dev/types/**/*.ts",
    ".next-e2e-wul127/types/**/*.ts",
    ".next-e2e-wul127/dev/types/**/*.ts",
    ".next-real-import/types/**/*.ts",
    ".next-real-import/dev/types/**/*.ts",
    ".next-manual-browser/types/**/*.ts",
    ".next-manual-browser/dev/types/**/*.ts",
    ".next-api-v1-put-negative/types/**/*.ts",
    ".next-api-v1-put-negative/dev/types/**/*.ts",
    ".next-legacy-clinical-writes/types/**/*.ts",
    ".next-legacy-clinical-writes/dev/types/**/*.ts",
    ".next-patient-concurrency/types/**/*.ts",
    ".next-patient-concurrency/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "lib/security/*-fixture.ts",
    "native/**/Build/**/*",
    "native/**/.build/**/*"
  ]
}
